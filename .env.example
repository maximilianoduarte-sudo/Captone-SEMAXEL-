# Copia este archivo como .env y completa los valores. El .env NO se sube a Git.

# Obligatoria. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True solo en desarrollo. En el servidor de pruebas o producción: False.
DEBUG=True

# Nombres o IP por los que se entra al servidor, separados por coma.
# Agrega la IP del equipo en la red (y el dominio o IP pública si se publica).
ALLOWED_HOSTS=localhost,127.0.0.1

# Conexión a MySQL 8 (base con charset utf8mb4).
DB_NAME=capstone_semaxel
DB_USER=semaxel
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Servidor de demostración sin servidor web aparte: Django entrega las fotos
# subidas (/media/) aunque DEBUG=False. En producción real, False.
SEMAXEL_SERVIR_MEDIA=False

# App móvil: radio (metros) para verificar la llegada con GPS.
SEMAXEL_RADIO_LLEGADA_METROS=150

# Notificaciones push: "consola" (solo log) o "fcm" (Firebase).
SEMAXEL_PUSH_BACKEND=consola
# Solo con "fcm": ruta al JSON de la cuenta de servicio de Firebase.
FCM_CREDENTIALS_FILE=
